# Copy this file to .env and fill in real values. Never commit .env.

# Telegram Bot API token from @BotFather. Format: 123456:ABC-xxxx
TELEGRAM_BOT_TOKEN=

# Numeric chat ID where alerts should be delivered. Get it from @userinfobot.
TELEGRAM_CHAT_ID=

# Optional: override the default SQLite path. Defaults to ./alert_bot.db
# ALERT_BOT_DB_PATH=alert_bot.db

# Optional: override poll interval in seconds. Defaults to 60.
# POLL_INTERVAL_SECONDS=60

# Optional: log level. Defaults to INFO. Set DEBUG when troubleshooting.
# LOG_LEVEL=INFO
